{% extends "base.html.jinja" %}
{% block title %}{{ effective_label }} - Ridal{% endblock %}
{% block content %}
  {#- Carries the active profile back to the catalog, so a round trip
      viewer -> catalog -> viewer stays in the profile you were browsing
      in rather than silently resetting to the default. -#}
  <p><a href="/?profile={{ active_profile }}#card-{{ radargram_id }}">&larr; Back to catalog</a></p>
  <h1>{{ effective_label }}{% if group_name %} (Group: {{ group_name }}){% endif %}</h1>
  <table class="meta">
    <tr>
      <th>Radargram ID</th>
      <td>
        <code>{{ radargram_id }}</code>
        (Rev. {{ revision_short }}; processed {{ processing_datetime }})
      </td>
    </tr>
  </table>

  <div class="controls">
    <label>Render profile:
      <select id="profile-select">
        {% for p in profiles %}
        <option value="{{ p }}" {% if p == active_profile %}selected{% endif %}>{{ p }}</option>
        {% endfor %}
      </select>
    </label>
    <label>Horizontal scale:
      <select id="xscale-select">
        <option value="0.25">0.25&times;</option>
        <option value="0.5">0.5&times;</option>
        <option value="1" selected>1&times;</option>
        <option value="2">2&times;</option>
        <option value="4">4&times;</option>
        <option value="8">8&times;</option>
      </select>
    </label>
    <button id="metadata-button" type="button">Metadata</button>
    <span id="cursor-readout"></span>
  </div>

  {#- The picking toolbar. Rendered even when the catalog is not a writable
      project, in which case it explains why rather than vanishing: a missing
      control reads as a missing feature. -#}
  <div class="controls picker-controls" id="picker-controls">
    {% if writable %}
      <label>Layer:
        <select id="pick-layer"><option value="">Loading&hellip;</option></select>
      </label>
      <button id="pick-toggle" type="button" aria-pressed="false">Start picking</button>
      <button id="pick-undo" type="button" disabled>Undo vertex</button>
      <button id="pick-finish" type="button" disabled>Finish line</button>
      <button id="pick-save" type="button" disabled>Save</button>
      <span id="pick-status" class="pick-status"></span>
      <a id="pick-download" class="pick-download" href="#" hidden>Download points</a>
    {% else %}
      <span class="pick-status">
        {% if project %}
          This server is read-only, so picks cannot be saved.
        {% else %}
          Not a Ridal project, so there is nowhere to save picks.
          Run <code>ridal project init</code> and restart.
        {% endif %}
      </span>
    {% endif %}
  </div>

  {#- Appears when a stored line is clicked. A sibling of the toolbar rather
      than a child: it acts on one existing line rather than on the drawing
      session, and showing it only when relevant is what makes "click a line
      to edit it" discoverable. -#}
  {% if writable %}
  <div class="controls picker-selection" id="pick-selection" hidden>
    <strong>Selected line</strong>
    <label>Layer:
      <select id="pick-selected-layer"></select>
    </label>
    <button id="pick-delete" type="button" class="danger">Delete line</button>
    <span id="pick-selection-hint" class="pick-status"></span>
  </div>
  {% endif %}

  <div id="pick-error" class="warning" role="status" aria-live="polite" hidden></div>

  <dialog id="download-dialog">
    <h2>Download level 2 points</h2>
    <p class="hint">
      Picked lines resampled to evenly spaced points along the ground track,
      with depth, travel time and position attached. Derived from the saved
      interpretation, so save first.
    </p>
    <div class="add-layer-fields">
      <label>Spacing
        <select id="download-spacing">
          <option value="auto" selected>Auto (from trace spacing)</option>
          <option value="1">1 m</option>
          <option value="5">5 m</option>
          <option value="10">10 m</option>
          <option value="25">25 m</option>
          <option value="per-trace">Every trace</option>
          <option value="vertices">Picked vertices only</option>
        </select>
      </label>
      <label>Format
        <select id="download-format">
          <option value="geojson" selected>GeoJSON (WGS84)</option>
          <option value="csv">CSV</option>
        </select>
      </label>
    </div>
    <p>
      <button type="button" id="download-go">Download</button>
      <button type="button" id="download-close">Close</button>
    </p>
  </dialog>

  <div class="layout" id="viewer-layout">
    <div id="map"></div>
    <div id="split-resizer" role="separator" aria-orientation="vertical"
         aria-label="Resize radargram and map panels"
         aria-valuemin="0" aria-valuemax="100" aria-valuenow="50" tabindex="0"></div>
    <div id="overview-map"></div>
  </div>

  <dialog id="metadata-dialog">
    <h2>Metadata</h2>
    <table id="metadata-table"><tbody></tbody></table>
    <details class="meta-details" id="processing-details">
      <summary>Processing steps &amp; log</summary>
      <ol id="processing-steps-list"></ol>
      <pre id="processing-log"></pre>
    </details>
    <details class="meta-details" id="filepaths-details">
      <summary>Original filepaths</summary>
      <ul id="filepaths-list"></ul>
    </details>
    <p><button type="button" id="metadata-close">Close</button></p>
  </dialog>
{% endblock %}
{% block extrascript %}
{#- The only inline JS left on this page: server-side values the static
    viewer.js cannot know. Everything else lives in that file, so it stays
    a plain asset with no templating in it. -#}
<script>
  window.RIDAL_VIEWER = {
    radargramId: "{{ radargram_id }}",
    groupId: {% if group_id %}"{{ group_id }}"{% else %}null{% endif %},
    chunkSize: {{ chunk_size }},
    nCols: {{ n_cols }},
    nRows: {{ n_rows }},
    viewerWidth: {{ viewer_width }},
    viewerHeight: {{ viewer_height }},
    sourceWidth: {{ shape_width }},
    sourceHeight: {{ shape_height }},
    writable: {% if writable %}true{% else %}false{% endif %},
    user: "{{ user }}",
  };
</script>
<script src="/static/viewer.js"></script>
<script src="/static/picker.js"></script>
{% endblock %}
